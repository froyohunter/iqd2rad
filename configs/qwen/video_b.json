{
  "arm": "b",
  "modality": "video",
  "base_model": "Qwen/Qwen3-VL-Embedding-2B",
  "base_revision": null,
  "manifest": "data/prepared/msrvtt_train/train.jsonl",
  "data_root": ".",
  "output_dir": "outputs/qwen-video-b",
  "seed": 42,
  "max_steps": 3001,
  "per_device_batch_size": 8,
  "global_batch_size": 128,
  "learning_rate": 1e-05,
  "weight_decay": 0.01,
  "warmup_steps": 300,
  "distill_warmup_steps": 200,
  "gradient_clip": 1.0,
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "bit_levels": [
    2,
    4,
    8
  ],
  "temperature": 0.07,
  "distill_temperature": 0.1,
  "distill_weight": 0.0,
  "online_diff_temperature": 1.0,
  "online_diff_zscore": true,
  "online_diff_clamp": 5.0,
  "use_global_negatives": false,
  "visual_input_includes_text": true,
  "max_frames": 64,
  "precision": "bf16",
  "device": "cuda",
  "attn_implementation": "flash_attention_2",
  "gradient_checkpointing": false,
  "local_files_only": false,
  "num_workers": 0,
  "save_every": 500,
  "log_every": 10,
  "wandb_project": null,
  "wandb_run_name": null
}
